apiVersion: v1
kind: ConfigMap
metadata:
  name: ftpipe-prometheus-adapter
  labels:
    app: ftpipe-vllm
data:
  config.yaml: |
    rules:
      - seriesQuery: 'vllm:num_requests_waiting{namespace!="",pod!=""}'
        resources:
          overrides:
            namespace: {resource: namespace}
            pod: {resource: pod}
        name:
          matches: "^(.*)$"
          as: "vllm:num_requests_waiting"
        metricsQuery: 'sum(vllm:num_requests_waiting{<<.LabelMatchers>>}) by (namespace, pod)'
