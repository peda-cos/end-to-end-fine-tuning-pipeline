apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ftpipe-vllm
  labels:
    app: ftpipe-vllm
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ftpipe-vllm
  minReplicas: 1
  maxReplicas: 8
  metrics:
    - type: External
      external:
        metric:
          name: vllm:num_requests_waiting
          selector:
            matchLabels:
              app: ftpipe-vllm
        target:
          type: AverageValue
          averageValue: "8"
